<odoo>
    <record id="view_data_center_form" model="ir.ui.view">
        <field name="name">data.center.form</field>
        <field name="model">data.center</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="price"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_data_center_tree" model="ir.ui.view">
        <field name="name">data.center.tree</field>
        <field name="model">data.center</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_data_center" name="Data Center" parent="base.menu_custom" sequence="10"/>
    <menuitem id="menu_data_center_main" name="Data Center" parent="menu_data_center"/>
    <act_window id="action_data_center" name="Data Center" res_model="data.center" view_mode="tree,form"/>
    <menuitem id="menu_data_center_action" name="Manage Data Center" parent="menu_data_center_main" action="action_data_center"/>
</odoo>
