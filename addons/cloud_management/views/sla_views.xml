<odoo>
    <record id="view_sla_form" model="ir.ui.view">
        <field name="name">sla.form</field>
        <field name="model">sla</field>
        <field name="arch" type="xml">
            <form string="SLA">
                <group>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="price"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_sla_tree" model="ir.ui.view">
        <field name="name">sla.tree</field>
        <field name="model">sla</field>
        <field name="arch" type="xml">
            <tree string="SLAs">
                <field name="name"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_sla" name="SLAs" parent="base.menu_management" sequence="2" action="action_sla"/>
    <record id="action_sla" model="ir.actions.act_window">
        <field name="name">SLAs</field>
        <field name="res_model">sla</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
