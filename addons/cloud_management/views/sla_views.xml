<odoo>
    <record id="view_sla_form" model="ir.ui.view">
        <field name="name">sla.form</field>
        <field name="model">sla</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="price"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_sla_tree" model="ir.ui.view">
        <field name="name">sla.tree</field>
        <field name="model">sla</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_sla" name="SLA" parent="base.menu_custom" sequence="20"/>
    <menuitem id="menu_sla_main" name="SLA" parent="menu_sla"/>
    <act_window id="action_sla" name="Service Level Agreement" res_model="sla" view_mode="tree,form"/>
    <menuitem id="menu_sla_action" name="Manage SLA" parent="menu_sla_main" action="action_sla"/>
</odoo>
