<odoo>
    <record id="view_solution_form" model="ir.ui.view">
        <field name="name">solution.form</field>
        <field name="model">solution</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="capacity"/>
                    <field name="description"/>
                    <field name="price"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_solution_tree" model="ir.ui.view">
        <field name="name">solution.tree</field>
        <field name="model">solution</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="capacity"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_solution" name="Solución" parent="base.menu_custom" sequence="50"/>
    <menuitem id="menu_solution_main" name="Soluciones" parent="menu_solution"/>
    <act_window id="action_solution" name="Solution" res_model="solution" view_mode="tree,form"/>
    <menuitem id="menu_solution_action" name="Manage Solutions" parent="menu_solution_main" action="action_solution"/>
</odoo>
