<odoo>
    <record id="view_cloud_powerback_form" model="ir.ui.view">
        <field name="name">cloud.powerback.form</field>
        <field name="model">cloud.powerback</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="capacity"/>
                    <field name="description"/>
                    <field name="price"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_cloud_powerback_tree" model="ir.ui.view">
        <field name="name">cloud.powerback.tree</field>
        <field name="model">cloud.powerback</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="capacity"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_cloud_powerback" name="Cloud PowerBack" parent="base.menu_custom" sequence="40"/>
    <menuitem id="menu_cloud_powerback_main" name="Cloud PowerBack" parent="menu_cloud_powerback"/>
    <act_window id="action_cloud_powerback" name="Cloud PowerBack" res_model="cloud.powerback" view_mode="tree,form"/>
    <menuitem id="menu_cloud_powerback_action" name="Manage Cloud PowerBack" parent="menu_cloud_powerback_main" action="action_cloud_powerback"/>
</odoo>
