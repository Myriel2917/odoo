<odoo>
    <record id="view_payment_type_form" model="ir.ui.view">
        <field name="name">payment.type.form</field>
        <field name="model">payment.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Pago">
                <group>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="price"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_payment_type_tree" model="ir.ui.view">
        <field name="name">payment.type.tree</field>
        <field name="model">payment.type</field>
        <field name="arch" type="xml">
            <tree string="Tipos de Pago">
                <field name="name"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_payment_type" name="Tipos de Pago" parent="base.menu_management" sequence="3" action="action_payment_type"/>
    <record id="action_payment_type" model="ir.actions.act_window">
        <field name="name">Tipos de Pago</field>
        <field name="res_model">payment.type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
