<odoo>
    <record id="view_payment_type_form" model="ir.ui.view">
        <field name="name">payment.type.form</field>
        <field name="model">payment.type</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="price"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_payment_type_tree" model="ir.ui.view">
        <field name="name">payment.type.tree</field>
        <field name="model">payment.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_payment_type" name="Tipo de Pagos" parent="base.menu_custom" sequence="30"/>
    <menuitem id="menu_payment_type_main" name="Tipos de Pagos" parent="menu_payment_type"/>
    <act_window id="action_payment_type" name="Payment Types" res_model="payment.type" view_mode="tree,form"/>
    <menuitem id="menu_payment_type_action" name="Manage Payment Types" parent="menu_payment_type_main" action="action_payment_type"/>
</odoo>
